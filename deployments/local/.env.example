# Copy to .env and edit.
# AUTH_BYPASS_ENABLED=true is safe for local dev only.

DEPLOYMENT_ENV=local
AUTH_BYPASS_ENABLED=true
BASE_URL=http://localhost:3000

# IAS credentials — only needed when AUTH_BYPASS_ENABLED=false
IAS_CLIENT_ID=
IAS_CLIENT_SECRET=
IAS_TENANT_URL=

# Database
POSTGRES_USER=toolkit
POSTGRES_PASSWORD=toolkit
POSTGRES_DB=toolkit

# Encryption key for instance client secrets (32-byte hex, generate with: openssl rand -hex 32)
ENC_KEY=
